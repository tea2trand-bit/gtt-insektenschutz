import {createAcceptanceLink} from './offer-acceptance-token.mts';
const html = (v: unknown) => String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]!));
export const money=(v:number)=>`CHF ${v.toLocaleString("de-CH",{minimumFractionDigits:2,maximumFractionDigits:2})}`;
const area=(v:number)=>v.toLocaleString("de-CH",{maximumFractionDigits:4})+" m²";
export const offerNumber=(_recordId:string,version:number)=>`GTT-${String(version).padStart(3,"0")}`;
export const legacyOfferNumber=(recordId:string,version:number)=>`GTT-${recordId.replace(/^GTT-/,"").slice(0,8).toUpperCase()}-${String(version).padStart(3,"0")}`;

export function renderQuoteEmail(snapshot:any,recordId:string,version:number,options:{baseURL?:string}={}) {
  const reference=offerNumber(recordId,version);
  const acceptanceURL=createAcceptanceLink(snapshot,recordId,version,options.baseURL);
  const declineURL=acceptanceURL?acceptanceURL+'&entscheidung=ablehnen':null;
  const pdfURL=acceptanceURL?acceptanceURL+'&download=pdf':null;
  const correction=!!snapshot.correction;
  const customer=snapshot.customer||{};
  const quote=snapshot.quote;
  const date=new Date(snapshot.processedAt).toLocaleDateString("de-CH",{timeZone:"Europe/Zurich",day:"2-digit",month:"2-digit",year:"numeric"});
  const title=snapshot.status==="priced"?(correction?'Korrigierte Offerte':'Offerte'):snapshot.measurementRequired?'Ihre Anfrage – Ausmessen vor Ort':"Ihre Anfrage – Angaben ergänzen";
  const contact=[customer.company,customer.name,customer.address,[snapshot.postalCode?`PLZ: ${snapshot.postalCode}`:null,customer.city].filter(Boolean).join(" "),customer.email,customer.phone].filter(Boolean);
  const lines: {label:string;detail:string;area:number;rate:number;amount:number}[]=[];
  if(quote) for(const [type,key,label] of [["window","fenster","Insektenschutz für Fenster nach Mass"],["door","tueren","Insektenschutz für Türen / Plissee nach Mass"]] as const){
    if(!quote.areas[key])continue;
    const measures=snapshot.measurements.filter((m:any)=>m.type===type);
    const detail=measures.map((m:any)=>m.mode==="dimensions"?`${m.quantity} × ${m.width} ${m.widthUnit} × ${m.height} ${m.heightUnit}`:`Gesamtfläche ${area(m.areaM2)}`).join("; ");
    lines.push({label,detail,area:quote.areas[key],rate:quote.rates[key],amount:quote.areas[key]*quote.rates[key]});
  }
  const positionTotal=lines.reduce((n,line)=>n+line.amount,0);
  const travelAmount=Number(quote?.travelCosts?.amountCHF)||0;
  const regular=quote?quote.areas.fenster*quote.baseRates.fenster+quote.areas.tueren*quote.baseRates.tueren:0;
  // Gross prices include VAT (AGB); standard rate: https://www.estv.admin.ch/de/mehrwertsteuer
  const vatRate=8.1;
  const includedVAT=quote?Math.round(quote.totalCHF*vatRate/(100+vatRate)*100)/100:0;
  const rows=lines.map((line,index)=>`<tr><td class="description"><strong>${index+1}. ${html(line.label)}</strong><br><span class="muted">${html(line.detail)}</span></td><td class="numeric">${html(area(line.area))}</td><td class="numeric">${html(money(line.rate))}<br><span class="muted">pro m²</span></td><td class="numeric"><strong>${html(money(line.amount))}</strong></td></tr>`).join("")+(travelAmount?`<tr><td class="description"><strong>${lines.length+1}. Anfahrtskosten</strong><br><span class="muted">Vereinbarte Pauschale inkl. MwSt.</span></td><td class="numeric">–</td><td class="numeric">pauschal</td><td class="numeric"><strong>${html(money(travelAmount))}</strong></td></tr>`:'');
  const questions=snapshot.measurementRequired?['Unser Team meldet sich bei Ihnen, um einen Termin zum Ausmessen vor Ort abzustimmen.','Nach dem Ausmessen erstellen wir Ihre Offerte.']:(snapshot.clarification||[]).map((q:any)=>typeof q==="string"?q:q.question);
  const confirmationText=correction?'Bitte bestätigen Sie die korrigierte Offerte auf Grundlage des Aufmasses vor Ort. Danach stimmt unser Team die Montage mit Ihnen ab.':"Bitte bestätigen Sie, dass Sie auf Grundlage dieser Offerte fortfahren und einen Termin zum Ausmessen vereinbaren möchten.";
  const priceNote=correction?'Die Offerte beruht auf den vor Ort erfassten Massen. Diese neue Version benötigt Ihre Bestätigung.':'Unverbindliche Offerte auf Grundlage Ihrer Angaben. Die Masse werden beim Ausmessen vor Ort geprüft.';
  const offerBlock=quote?`
    <p>${correction?'Nach dem Ausmessen erhalten Sie Ihre korrigierte Offerte. Bisher: '+html(money(snapshot.correction.previousTotalCHF))+'. Neu: '+html(money(quote.totalCHF))+'.':'Vielen Dank für Ihre Anfrage. Auf Grundlage Ihrer Angaben offerieren wir Ihnen folgende massgefertigten Insektenschutzlösungen:'}</p>
    <table class="positions" role="table"><thead><tr><th>Position / Ausführung</th><th class="numeric">Fläche</th><th class="numeric">Einzelpreis</th><th class="numeric">Betrag</th></tr></thead><tbody>${rows}</tbody></table>
    ${quote.discount?`<div class="discount"><strong>${html(quote.discount.name)} −${html(quote.discount.percent)}%</strong><br>Regulärer Positionswert: ${html(money(regular))}<br>Aktionsvorteil: ${html(money(regular-positionTotal))} – bereits in den gerundeten Einheitspreisen berücksichtigt.</div>`:""}
    <table class="totals" role="presentation"><tr><td>Summe der Positionen</td><td>${html(money(positionTotal+travelAmount))}</td></tr><tr class="grand"><td>Gesamtbetrag inkl. MwSt.</td><td>${html(money(quote.totalCHF))}</td></tr><tr><td><small class="muted">Darin enthaltene MwSt. (${html(vatRate)} %):</small></td><td><small class="muted">${html(money(includedVAT))}</small></td></tr></table>
    <p class="muted">${html(priceNote)}</p>
    ${quote.travelCosts?.status==='requires_review'?'<p class="muted">Anfahrtskosten sind noch abzuklären und im Richtpreis noch nicht enthalten.</p>':''}
    <h2>Im Preis enthalten</h2><p>Ausmessen vor Ort · Lieferung und Montage · 2 Jahre Garantie</p>
    ${pdfURL?`<p><a href="${html(pdfURL)}">Offerte als A4-PDF herunterladen</a></p>`:""}<div class="next"><h2>Der nächste Schritt</h2>${acceptanceURL?`<p><a href="${html(acceptanceURL)}" style="display:inline-block;padding:12px 18px;margin:0 8px 8px 0;background:#347a2b;border-radius:7px;color:#fff;text-decoration:none">Offerte annehmen</a> <a href="${html(declineURL)}" style="display:inline-block;padding:11px 17px;margin-bottom:8px;background:#fff;border:1px solid #b8c5b5;border-radius:7px;color:#445143;text-decoration:none">Offerte ablehnen</a></p><p>${html(confirmationText)}</p>`:'<p>Antworten Sie auf diese E-Mail, um das Ausmessen und die weiteren Details mit unserem Team abzusprechen.</p>'}</div>`:
    `<p>${snapshot.measurementRequired?'Vielen Dank für Ihre Anfrage. Gerne unterstützen wir Sie beim Ausmessen.':'Vielen Dank für Ihre Anfrage. Damit wir die passende Offerte erstellen können, benötigen wir noch folgende Angaben:'}</p><ul>${questions.map((q:string)=>`<li>${html(q)}</li>`).join("")}</ul>${snapshot.measurements.length?`<h2>Bereits erfasste Angaben</h2><ul>${snapshot.measurements.map((m:any)=>`<li>${m.type==="window"?"Fenster":"Tür / Plissee"}: ${html(m.source)}</li>`).join("")}</ul>`:""}${snapshot.measurementRequired?'':'<p>Bitte antworten Sie direkt auf diese E-Mail. Unser Team prüft die ergänzten Angaben.</p>'}`;
  const body=`<!doctype html><html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>${html(title)} ${html(reference)}</title><style>
    body{margin:0;background:#f3f4f2;color:#233027;font:15px/1.55 Arial,Helvetica,sans-serif}.sheet{max-width:680px;margin:24px auto;background:#fff;border:1px solid #dce2dc;border-radius:6px}.inner{padding:32px}.brand{font-size:17px;letter-spacing:.3px;color:#235f2c;font-weight:bold}.brand small{display:block;color:#657168;font-size:12px;font-weight:normal;letter-spacing:0}.heading{width:100%;border-collapse:collapse;border-bottom:3px solid #326b3b;margin-bottom:24px}.heading td{vertical-align:top;padding-bottom:20px}.heading .meta{text-align:right;font-size:12px;color:#55615a}h1{font-size:27px;line-height:1.2;margin:8px 0 6px;font-weight:600}h2{font-size:15px;margin:22px 0 7px}.customer{margin:0 0 24px;padding:0 0 16px;border-bottom:1px solid #e6e9e5;overflow-wrap:anywhere}p{margin:0 0 16px}.muted{color:#647167;font-size:12px}.positions{width:100%;border-collapse:collapse;table-layout:fixed;margin:24px 0 12px;font-size:12px}.positions th{text-align:left;color:#536157;font-size:11px;border-bottom:2px solid #cfd7cf;padding:8px 5px}.positions td{vertical-align:top;border-bottom:1px solid #e2e6e0;padding:14px 5px;overflow-wrap:anywhere}.positions th:first-child{width:43%}.positions th:nth-child(2){width:13%}.positions th:nth-child(3){width:21%}.positions th:nth-child(4){width:23%}.positions .numeric{text-align:right}.description strong{font-size:13px}.discount{padding:12px 0;color:#48574b;font-size:12px}.totals{width:100%;border-collapse:collapse;margin:14px 0 16px}.totals td{padding:6px 4px;font-size:13px}.totals td:last-child{text-align:right;font-variant-numeric:tabular-nums}.totals .grand td{border-top:2px solid #617c64;padding-top:13px;font-size:19px;font-weight:bold;color:#244f2c}.next{border-top:1px solid #dce2d9;margin-top:24px}.footer{border-top:1px solid #dce2d9;padding-top:18px;margin-top:25px;font-size:12px;color:#657168}a{color:#235f2c}li{margin:0 0 9px;overflow-wrap:anywhere}@media(max-width:480px){body{font-size:14px}.sheet{margin:0;border:0;border-radius:0}.inner{padding:22px 14px}.brand{font-size:15px}.heading .meta{font-size:10px;max-width:135px;overflow-wrap:anywhere}h1{font-size:25px}.positions{font-size:11px}.positions th{font-size:10px;padding:6px 3px}.positions td{padding:12px 3px}.description strong{font-size:11px}.positions .muted{font-size:10px}.totals .grand td{font-size:17px}}
    </style></head><body><main class="sheet"><div class="inner"><table class="heading" role="presentation"><tr><td><div class="brand">GTT Insektenschutz<small>GT-Trading GmbH · St. Gallen</small></div><h1>${html(title)}</h1></td><td class="meta">${quote?"Offerte":"Anfrage"} Nr.<br><strong>${html(reference)}</strong><br>Datum: ${html(date)}</td></tr></table><div class="customer">${contact.map((s:string)=>html(s)).join("<br>")}</div>${offerBlock}<div class="footer"><strong>GTT Insektenschutz · GT-Trading GmbH</strong><br>Quimbystrasse 7 · CH-9015 St. Gallen<br>+41 (0)76 422 92 42<br><a href="mailto:info@gttgroup.ch">info@gttgroup.ch</a> · <a href="https://www.gtt-insektenschutz.ch">www.gtt-insektenschutz.ch</a></div></div></main></body></html>`;
  const text=[`GTT Insektenschutz – ${title}`,`${quote?"Offerte":"Anfrage"} Nr. ${reference} · ${date}`,"",...contact,"",...(quote?[...lines.map(l=>`${l.label}\n${l.detail}\n${area(l.area)} × ${money(l.rate)}/m² = ${money(l.amount)}`),...(quote.discount?[`${quote.discount.name} −${quote.discount.percent}%: Aktionsvorteil ${money(regular-positionTotal)} bereits in Positionspreisen berücksichtigt; regulärer Wert ${money(regular)}.`]:[]),...(travelAmount?[`Anfahrtskosten (pauschal, inkl. MwSt.): ${money(travelAmount)}`]:[]),`Gesamtbetrag inkl. MwSt.: ${money(quote.totalCHF)}`,`Darin enthaltene MwSt. (${vatRate} %): ${money(includedVAT)}`,...(quote.travelCosts?.status==="requires_review"?["Anfahrtskosten sind noch abzuklären und im Richtpreis noch nicht enthalten."]:[]),priceNote,"Inklusive Ausmessen vor Ort, Lieferung und Montage, 2 Jahre Garantie.",correction?"Nach Bestätigung wird die Montage abgestimmt.":"Bitte antworten Sie für die Absprache des Ausmessens."]:questions),"","GTT Insektenschutz · GT-Trading GmbH","Quimbystrasse 7 · CH-9015 St. Gallen","+41 (0)76 422 92 42 · info@gttgroup.ch","www.gtt-insektenschutz.ch"].join("\n");
  return {reference,subject:quote?`${correction?"Ihre korrigierte Offerte":"Ihre Offerte"} ${reference} – ${money(quote.totalCHF)}`:`Ihre Anfrage ${reference} – ${snapshot.measurementRequired?'Ausmessen vor Ort':'Angaben ergänzen'}`,html:body,text:acceptanceURL?text+'\n\nOfferte annehmen: '+acceptanceURL+'\n'+confirmationText+'\n\nOfferte ablehnen: '+declineURL+'\n\nA4-PDF herunterladen: '+pdfURL:text,acceptanceURL,declineURL,pdfURL};
}
